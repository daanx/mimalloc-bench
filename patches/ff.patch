+// Jumbo pools come straight from the OS and are only page aligned. Ask for
+// the alignment in excess and return an address aligned inside the pool:
+// free(), realloc() and malloc_usable_size() resolve a pointer to the pool
+// that contains it, so any address inside the pool is valid to free.
+static inline void* ffalign_jumbo(size_t alignment, size_t size) {
+	if(alignment > PAGE_SIZE) {
+		if(size + alignment < size) {
+			return NULL;
+		}
+		size += alignment;
+	}
+	void* ptr = ffmalloc_jumbo(size, arenas[0]);
+	if(ptr == NULL) {
+		return NULL;
+	}
+	return (void*)ALIGN_TO((uintptr_t)ptr, alignment);
+}
+
