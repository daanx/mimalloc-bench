diff -ruN a/src/iso_alloc_util.c b/src/iso_alloc_util.c
--- a/src/iso_alloc_util.c	2022-12-16 15:47:24.000000000 +0100
+++ b/src/iso_alloc_util.c	2026-11-26 13:28:51.561445177 +0100
@@ -77,6 +77,27 @@
     return (p + g_page_size);
 }
 
+/* Same contract as mmap_guarded_rw_pages but the returned user pages
+ * are aligned to the requested alignment. The slack pages between the
+ * guard pages and the aligned user pages stay mapped and are
+ * mprotected so the overflow protection is unchanged. */
+INTERNAL_HIDDEN ASSUME_ALIGNED void *mmap_aligned_rw_pages(size_t size, size_t align, bool populate, const char *name) {
+    const size_t sz = ROUND_UP_PAGE(size);
+    void *p = mmap_rw_pages(sz + align + (g_page_size * 2), populate, name);
+
+    create_guard_page(p);
+    create_guard_page(p + (g_page_size + sz + align));
+
+    void *user = (void *) (((uintptr_t) (p + g_page_size) + (align - 1)) & (~(align - 1)));
+
+    if(user != p + g_page_size) {
+        mprotect_pages(p + g_page_size, (size_t) (user - (p + g_page_size)), PROT_NONE);
+    }
+
+    mprotect_pages(user + sz, (size_t) ((p + g_page_size + sz + align) - (user + sz)), PROT_NONE);
+    return user;
+}
+
 INTERNAL_HIDDEN ASSUME_ALIGNED void *mmap_rw_pages(size_t size, bool populate, const char *name) {
     return mmap_pages(size, populate, name, PROT_READ | PROT_WRITE);
 }
