diff -ruN a/libguarder.cpp b/libguarder.cpp
--- a/libguarder.cpp	2018-10-11 00:22:28.000000000 +0200
+++ b/libguarder.cpp	2026-11-25 17:46:48.838221656 +0100
@@ -394,3 +394,17 @@
 int pthread_join(pthread_t tid, void** retval) {
 	return xthread::getInstance().thread_join(tid, retval);
 }
+
+// pthread_exit must land in the trampoline's PTHREADEXIT_CODE handler or
+// the thread's slot leaks; the initial thread's pthread_exit still ends
+// the process.
+void pthread_exit(void *retval) {
+	if(heapInitStatus != E_HEAP_INIT_DONE) {
+			heapinitialize();
+	}
+	if(xthread::getInstance().isInitialThread()) {
+		Real::pthread_exit(retval);
+	}
+	pendingExitRetval = retval;
+	throw PTHREADEXIT_CODE;
+}
